<!-- ============================= HERO ============================= -->
<section class="hero">
  <svg class="hero__blob" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill="#e3f0e6" d="M437,320Q420,390,360,430Q300,470,235,445Q170,420,140,355Q110,290,150,225Q190,160,260,140Q330,120,390,165Q450,210,450,265Q450,270,437,320Z"/>
