<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <a class="footer-brand" href="/">
          <span class="footer-brand__mark">{% include "partials/logo-mark.njk" %}</span>
          Verlorene Hundeseelen
        </a>
        <p>Gemeinnütziger Tierschutzverein. Verantwortungsvoll, transparent, immer im Sinne des Hundes.</p>
        <div class="footer-social mt-lg" aria-label="Social Media">
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
          </a>
          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 8h-2a2 2 0 0 0-2 2v10M8 13h5"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Navigation</h4>
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Rechtliches &amp; Kontakt</h4>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ year }} {{ site.legalName }}</span>
      <span>{{ site.address.street }}, {{ site.address.zipCity }}</span>
    </div>
  </div>
</footer>
